{
  "schema": "umicom.project/1",
  "id": "umicom.umicom-os",
  "name": "Umicom OS",
  "type": "operating-system",
  "path": "operating-systems/umicom-os",
  "repository": "https://github.com/umicom-foundation/umicom-os.git",
  "status": "active",
  "enabled": true,
  "framework_required": true,
  "frontends": [],
  "layers": {
    "linux-kernel": {
      "framework_dependency": false
    },
    "base-userland": {
      "framework_dependency": false
    },
    "umicom-user-space": {
      "framework_dependency": true
    },
    "desktop-shell": {
      "framework_dependency": true,
      "ui_adapter": "gtk4"
    }
  },
  "required_framework_capabilities": [
    "umicom.runtime/1",
    "umicom.platform/1",
    "umicom.security/1",
    "umicom.messaging/1",
    "umicom.ui/1"
  ],
  "optional_framework_capabilities": [
    "umicom.ui.gtk4/1",
    "umicom.web/1",
    "umicom.ai/1"
  ],
  "repository_layout": "root-framework-submodule + applications/os",
  "ui_component_target": "Umicom::ui_components",
  "desktop_target": "Umicom::ui_gtk4"
}
